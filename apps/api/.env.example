# Copy to apps/api/.env — never commit real values.
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (Supabase dev project or local Postgres 16). Use a NON-superuser role so RLS applies.
DATABASE_URL=postgresql+psycopg://jobpilot_app:CHANGE_ME@localhost:5432/jobpilot
# Table-owner role used only by `alembic upgrade head` (not by the running API).
MIGRATION_DATABASE_URL=postgresql+psycopg://jobpilot_owner:CHANGE_ME@localhost:5432/jobpilot
# Role that receives table privileges in migrations (default jobpilot_app).
APP_DB_ROLE=jobpilot_app

# Supabase Auth: the API only verifies JWTs (JWKS), it never handles passwords.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated
# Optional but recommended: https://YOUR-PROJECT.supabase.co/auth/v1
JWT_ISSUER=

# Anthropic
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=2.00
LLM_MONTHLY_BUDGET_USD=15.00

# CORS: the deployed web origin(s), comma separated
CORS_ORIGINS=http://localhost:3000

# Job sources (Phase 5)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
